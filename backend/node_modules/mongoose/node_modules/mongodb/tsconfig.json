{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "alwaysStrict": true,

    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "skipLibCheck": true,

    "lib": [
      "ES2021",
      "ES2022.Error",
      "ES2022.Object",
      "ESNext.Disposable"
    ],

    "importHelpers": false,
    "noEmitHelpers": true,
    "noEmitOnError": true,

    "outDir": "lib",

    "inlineSourceMap": false,
    "sourceMap": true,

    "declaration": true,
    "declarationMap": true,

    "inlineSources": false,

    "types": [
      "node"
    ],

    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    "useUnknownInCatchVariables": false
  },

  "include": [
    "src/**/*"
  ],

  "exclude": [
    "node_modules",
    "coverage",
    "lib"
  ]
}